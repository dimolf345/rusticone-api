# Application JWT settings
JWT_ACCESS_SECRET=replace-with-a-secure-access-token-secret
JWT_REFRESH_SECRET=replace-with-a-secure-refresh-token-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis session cache
REDIS_URL=redis://localhost:6379
SESSION_CACHE_TTL_SECONDS=300

# Local image uploads (used outside production)
UPLOAD_LOCAL_DIR=uploads
PUBLIC_BASE_URL=http://localhost:3000

# Cloudinary image uploads (required in production; optional in development)
CLOUDINARY_CLOUD_NAME=CLOD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_SECRET

# Test runner override (normally set automatically by test.config.ts)
TSX_TSCONFIG_PATH=tsconfig.test.json
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# MongoDB connection and retry settings
MONGO_INITDB_DATABASE=mongodb://mongo:27017/rusticone-dev
MONGODB_MAX_RETRIES=5
MONGODB_RETRY_DELAY_MS=2000
GOOGLE_CLIENT_ID=example.apps.googleusercontent.com


FRONTEND_ORIGINS=http://localhost:4200,http://localhost:3001

AUTH_SESSION_CACHE_TIMEOUT_MS=100
AUTH_SESSION_CACHE_COOLDOWN_MS=1000

# Google sign-in. Required when using POST /api/auth/google.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_SECRET=YOUR_GOOGLE_SECRET

# SMTP / email notifications (leave blank to disable quote notification emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-password
FROM_EMAIL="Pizzeria Catering <noreply@pizzeria.com>"
ADMIN_EMAIL=admin@pizzeria.com
